# ConnectClaw Configuration Template
# Copy this file to ~/.connectclaw/config.toml and fill in your values

[llm]
# LLM API key (required)
api_key = "${LLM_API_KEY}"
# LLM API base URL
base_url = "https://api.deepseek.com"
# Model ID to use
model_id = "deepseek-chat"
# Context window and max output tokens (used for compaction budgets / summarizer caps)
# context_window = 65536
# max_tokens = 8192
# Model is a reasoning model (offers thinking blocks when [agent].thinking_level != off)
# reasoning = true

[proxy]
# Outbound proxy for MODEL APIs only (LLM + retained vision). Feishu SDK,
# Lightpanda/browser, and other outbound consumers deliberately do NOT go
# through this. Env override: CONNECTCLAW_PROXY_URL (default route only).
#
# `url` is the default for every endpoint; `hosts` maps a destination
# hostname to its own proxy URL ("" = explicitly direct).
url = ""
# [proxy.hosts]
# "api.example.com" = "http://127.0.0.1:8080/"

[feishu]
# Feishu/Lark app ID (required)
app_id = "${FEISHU_APP_ID}"
# Feishu/Lark app secret (required)
app_secret = "${FEISHU_APP_SECRET}"

[vision]
# Vision model API key (for image analysis, optional)
api_key = "${VISION_API_KEY}"
# Vision API base URL
base_url = ""
# Vision model ID
model_id = ""
# Vision is a model API too: it uses the per-host [proxy] route for its
# base_url (falling back to [proxy].url). Override with:
# proxy = "http://127.0.0.1:7980/"

[agent]
# Working directory (default: current directory)
cwd = "."
# Thinking/reasoning level: off, minimal, low, medium, high, xhigh
thinking_level = "off"
# Base primitives exposed DIRECTLY to the main agent (a whitelist). Named agents
# and dynamic tools are NOT listed here — they are reached through the single
# `agents` meta-tool, so a newly created agent is usable the same turn and the
# tools array stays byte-stable (prefix cache). Omit this line to expose all.
# Unknown names are dropped (warning); empty resolves to ["read","bash"].
# NOTE: explicit non-empty list REPLACES the default — keep it in sync when
# new base tools land (e.g. view_image for local-image viewing).
tools = ["read", "write", "hash_read", "hash_edit", "bash", "web_search", "web_fetch", "attach_image", "view_image", "send_file"]
# Idle seconds before a stateful scripted-tool session (e.g. the browser) is reaped.
tool_session_idle_timeout = 300

[sandbox]
# Isolation for the agent's OWN bash tool. auto | bwrap | unshare | none
#   auto    — detect at runtime (bwrap → unshare → direct). Default.
#   bwrap   — force bubblewrap (falls back to direct if unusable here).
#   unshare — force plain namespaces (same fallback).
#   none    — NO isolation: the agent's bash runs directly on the host as the
#             bot user ("full permissions"). bash can then edit config.toml /
#             models.toml — the files gating the `!` escape hatch and the model
#             registry — so the agent could widen its own permissions. Only set
#             this on a machine you fully trust the agent on. BashGuard's
#             DANGEROUS pattern gate still applies.
# Override with the CONNECTCLAW_SANDBOX env var.
mode = "auto"

[session]
# Session storage directory
dir = "~/.connectclaw/sessions"

[rag]
# Enable RAG (requires lancedb, sentence-transformers, FlagEmbedding)
enabled = false
# Directory containing documents to index
docs_dir = ""
# LanceDB database path
db_path = "~/.connectclaw/rag_db"
# Number of candidates to retrieve from vector search
top_k = 20
# Number of results after reranking
top_n = 5

[web_search]
# Web search/fetch tools. Search hits Bing's RSS endpoint over plain HTTP
# (structured results, fast); fetch uses a plain-HTTP fast path — both fall
# back to the bundled Lightpanda headless browser (lightpanda-py, binary
# included) for JS-rendered pages or when the fast path is unavailable.
# Max characters in search/fetch response
max_chars = 8000
# Timeout in seconds (HTTP requests + browser navigation budget)
timeout = 30
# Max concurrent browser sessions sharing one Lightpanda serve process
pool_size = 16
# models.toml profile name used by web_fetch's `prompt` extraction (a cheap
# small model). Empty = follow the active main model (hot-switches with /model).
extract_model = ""

[compaction]
# Enable automatic context compaction
enabled = true
# Tokens reserved for output + system prompt/tools (not usable by history)
reserve_tokens = 16384
# Compact when history reaches this fraction of (context_window - reserve_tokens)
trigger_ratio = 0.8
# Tokens to keep in recent context after compaction
keep_recent_tokens = 20000
# Hard cap on the generated summary (it stays in context after compaction)
summary_max_tokens = 4096
# Hard cap on the merged memory/injection snapshot kept after compaction
memory_snapshot_max_tokens = 2000

[memory]
# Layered memory: auto-extract facts/events/patterns from conversations,
# persist across sessions, inject into the USER MESSAGE (never system prompt,
# to keep DeepSeek's prefix cache hitting). View with /memory in Feishu.
enabled = true
# SQLite single-file store (zero external deps)
db_path = "~/.connectclaw/memory.db"
# Extract only every N turns to save API cost (and only after this many turns)
extract_min_turns = 3
extract_interval_turns = 5
# Token budget for recalled memories injected per turn
max_context_tokens = 2000
# Memories newer than this many days count as "recent" (shown in full detail)
recency_threshold_days = 7
# Use embeddings (BGE-M3) for semantic retrieval — auto-uses GPU if available.
# Needs `sentence-transformers` (in the [rag] optional group). Falls back to
# keyword search if unavailable, but keyword recall is poor for Chinese (no
# word segmentation), so embeddings are strongly recommended.
use_embeddings = true
# Background consolidation ("dreaming") interval, hours; also via /dream
dream_interval_hours = 24.0
# Strength half-life for time-based decay, days
decay_halflife_days = 30.0
# Enable episodic→semantic consolidation during dreaming
consolidation_enabled = true
